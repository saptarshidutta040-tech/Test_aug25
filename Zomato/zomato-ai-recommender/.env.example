# ─── LLM Provider ───────────────────────────────────────────────────────────
# Supported: openai | gemini | grok
LLM_PROVIDER=grok

# ─── API Keys ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=

# ─── Model Configuration ─────────────────────────────────────────────────────
# Available Groq models: qwen/qwen3.8-27b | openai/gpt-oss-120b | groq/compound-mini
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=1200

# ─── Filter Configuration ────────────────────────────────────────────────────
# Maximum number of candidates passed to the LLM
TOP_K_CANDIDATES=15
